{
  "name": "pensa-junto",
  "productName": "Pensa Junto",
  "version": "1.1.0",
  "description": "Tutor de matemática offline para o 3º ano, com modelo de linguagem local.",
  "main": "./out/main/index.js",
  "author": "Pensa Junto",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "reset": "node scripts/reset.mjs",
    "bench": "electron-vite build && node scripts/bench.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "node-llama-cpp": "^3.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/lexend": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "framer-motion": "^11.18.2",
    "globals": "^16.0.0",
    "lucide-react": "^1.48.0",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "node-llama-cpp@3.21.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.4.5": true
  }
}
